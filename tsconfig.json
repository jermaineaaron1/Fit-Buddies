{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    // Edge Functions run on Deno, not React Native — different globals
    // (Deno.serve) and a different module resolution. They are type-checked by
    // the Supabase CLI at deploy time, not by this config.
    "supabase/functions"
  ]
}
